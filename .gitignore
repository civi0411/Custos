# ==============================================================================
# Custos — Git Ignore Specification (Rust-First Polyglot Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust & Cargo Core
# ------------------------------------------------------------------------------
target/
debug/
**/*.rs.bk
*.pdb
**/mutants.out*/
*.profraw
*.profdata

# ------------------------------------------------------------------------------
# 2. Python Sidecars (sidecars/python-judgment)
# ------------------------------------------------------------------------------
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/
ENV/

# Tooling & Testing Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 3. TypeScript / Node Sidecars (sidecars/ts-claude-agent & UI)
# ------------------------------------------------------------------------------
node_modules/
dist/
out/
build/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.eslintcache/

# ------------------------------------------------------------------------------
# 4. Custos Runtime Daemon, Persistence & Sandboxes
# ------------------------------------------------------------------------------
# SQLite Databases & Write-Ahead Logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local Daemon State & Ephemeral Worktrees
.custos/
worktrees/
data/
storage/
logs/
*.log
*.trace

# ------------------------------------------------------------------------------
# 5. Secrets & Local Environment Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 7. IDEs & Editors
# ------------------------------------------------------------------------------
# JetBrains
.idea/
*.iml

# VS Code / Cursor (Ignore user local workspace state, keep shared settings if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Emacs
*.swp
*.swo
.#*

