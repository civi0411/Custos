{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custos",
  "version": "0.1.0",
  "identifier": "ai.custos.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui/desktop run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../ui/desktop run build",
    "frontendDist": "../../../ui/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Custos Platform — Chat & Code Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
