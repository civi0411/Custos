{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "custos",
  "version": "0.1.0",
  "identifier": "com.custos.cli",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui/cli run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../ui/cli run build",
    "frontendDist": "../../../ui/cli/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Custos CLI — Guardian of Agentic Work",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
