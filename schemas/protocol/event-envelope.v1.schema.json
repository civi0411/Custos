{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custos.dev/schemas/protocol/event-envelope.v1.schema.json",
  "title": "EventEnvelope",
  "description": "Standard envelope for all re-playable ordered state events in Custos Local API",
  "type": "object",
  "required": ["cursor", "event_id", "timestamp", "event_type", "payload"],
  "properties": {
    "cursor": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
