{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custos Coding Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "base_commit",
    "worktree_id",
    "change_plan_ref",
    "diff_artifact_ref",
    "changed_files",
    "command_receipts",
    "skipped_checks",
    "remaining_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "minLength": 1
    },
    "worktree_id": {
      "type": "string",
      "minLength": 1
    },
    "change_plan_ref": {
      "type": "string"
    },
    "diff_artifact_ref": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "argv",
          "exit_code",
          "duration_ms",
          "output_hash"
        ],
        "properties": {
          "command": { "type": "string" },
          "argv": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "output_hash": { "type": "string" }
        }
      }
    },
    "skipped_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_verdict": {
      "type": ["string", "null"]
    }
  }
}
