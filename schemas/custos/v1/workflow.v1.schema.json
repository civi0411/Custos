{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custos Workflow Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "steps",
    "retry"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "capability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": ["deterministic", "model", "agent_loop", "verifier", "approval"]
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "only"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
