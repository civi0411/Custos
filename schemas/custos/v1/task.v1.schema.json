{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custos Task Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "parent_task_id",
    "requested_by",
    "domain",
    "task_type",
    "goal",
    "definition_of_done",
    "privacy_class",
    "max_risk",
    "scopes",
    "budget",
    "workflow_ref",
    "status",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": ["string", "null"]
    },
    "requested_by": {
      "type": "string"
    },
    "domain": {
      "enum": ["coding", "research", "assistant"]
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "privacy_class": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "max_risk": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network"],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": {
              "type": "array",
              "items": { "type": "string" }
            },
            "write": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "network": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_s",
        "max_model_input_tokens",
        "max_model_output_tokens",
        "max_tool_calls",
        "max_cost_usd"
      ],
      "properties": {
        "wall_time_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_model_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "workflow_ref": {
      "type": "string"
    },
    "status": {
      "enum": [
        "CREATED",
        "READY",
        "RUNNING",
        "WAITING",
        "PAUSED",
        "CANCEL_REQUESTED",
        "COMPENSATING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
