{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custos Provider Capability Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "integration_modes",
    "capabilities",
    "limits",
    "security",
    "cost",
    "health"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "integration_modes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured_output", "tool_calling", "repository_edit", "native_resume"],
      "properties": {
        "structured_output": { "type": "boolean" },
        "tool_calling": { "type": "boolean" },
        "repository_edit": { "type": "boolean" },
        "native_resume": { "type": "string" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_window", "max_parallel_sessions"],
      "properties": {
        "context_window": { "type": "string" },
        "max_parallel_sessions": { "type": "string" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox_control", "network_control"],
      "properties": {
        "sandbox_control": { "type": "string" },
        "network_control": { "type": "string" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounting"],
      "properties": {
        "accounting": { "type": "string" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circuit_breaker"],
      "properties": {
        "circuit_breaker": { "type": "string" }
      }
    }
  }
}
