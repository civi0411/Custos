{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custos Research Claim Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim",
    "claim_type",
    "scope",
    "evidence",
    "aggregate_confidence",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": ["empirical", "theoretical", "methodological", "background"]
    },
    "scope": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "stance",
          "locator",
          "excerpt_ref",
          "context_ref",
          "extraction_confidence"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "stance": {
            "enum": ["supports", "contradicts", "insufficient"]
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "section", "char_span"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "section": { "type": "string" },
              "char_span": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer" }
              }
            }
          },
          "excerpt_ref": { "type": "string" },
          "context_ref": { "type": "string" },
          "extraction_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "aggregate_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "enum": ["unverified", "verified", "disputed", "rejected"]
    }
  }
}
