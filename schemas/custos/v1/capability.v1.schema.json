{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability design manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "enabled",
    "runtime",
    "tools",
    "effects",
    "verifier",
    "limits",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "runtime": {
      "enum": [
        "deterministic",
        "model",
        "subgraph"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifier": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "tool_calls"
      ],
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status": {
      "enum": [
        "design-only",
        "experimental",
        "enabled"
      ]
    }
  }
}
